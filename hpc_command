<-------------------------- How to Check Server Architecture  -------------------->

# full CPU info
lscpu

# key CPU summary
lscpu | grep -E "Socket|Core|Thread|CPU\(s\)|Model name"

# memory info (no free command)
awk '/MemTotal/{print "Total:", $2/1024/1024, "GB"}
     /MemAvailable/{print "Free:", $2/1024/1024, "GB"}' /proc/meminfo

# storage info (no df command)
python3 -c "
import os
for p in ['/nfs/slurm/assu002', '/tmp', '/dev/shm']:
    try:
        s = os.statvfs(p)
        total = s.f_blocks * s.f_frsize // 1024**3
        free  = s.f_bfree  * s.f_frsize // 1024**3
        print(f'{p:<30} total={total}GB  free={free}GB')
    except: pass
"

# GPU info (no nvidia-smi flags)
python3 -c "
import torch
print('GPU name :', torch.cuda.get_device_name(0))
print('VRAM     :', torch.cuda.get_device_properties(0).total_memory//1024**3, 'GB')
print('CUDA     :', torch.version.cuda)
"

# network interfaces
ip -brief addr

# node details from Slurm
