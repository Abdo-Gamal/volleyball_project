#show 20 line in this file 
head -20 /nfs/slurm/$USER/projects/volleyball_project/models/baseline_model3/Run_Baseline3_person_model.py

# show num_workers in script
grep -n "num_workers\|cpu_count\|build_dataloader" \
/nfs/slurm/$USER/projects/volleyball_project/models/baseline_model3/Run_Baseline3_person_model.py


# change line of code  "cahnge num_workers=os.cpu_count() ot num_workers=2"
sed -i 's/num_workers=os.cpu_count()/num_workers=2/g' \
    /nfs/slurm/$USER/projects/volleyball_project/models/baseline_model3/Run_Baseline3_group_model.py


# fix 2 - increase workers to 4
sed -i 's/num_workers=2/num_workers=4/' \
    /nfs/slurm/$USER/volleyball_project/models/baseline_model3/Run_Baseline3_person_model.py

# fix 1 - increase batch size
sed -i 's/batch_size: 32/batch_size: 256/' \
    /nfs/slurm/$USER/projects/volleyball_project/configs/baseline3_person.yaml

# This shows exactly how many CPUs are allocated to your current job.
